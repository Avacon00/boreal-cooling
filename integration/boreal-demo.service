[Unit]
Description=Boreal Kraken demo user service
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/boreal --daemon --demo
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
