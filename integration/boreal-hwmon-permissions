#!/usr/bin/python3
"""Optional udev helper; install root-owned. Grants only Kraken PWM files."""
import grp
import os
from pathlib import Path
import re
import sys

if len(sys.argv) != 2 or not sys.argv[1].startswith('/devices/'):
    raise SystemExit('Expected udev DEVPATH below /devices')
path = (Path('/sys') / sys.argv[1].lstrip('/')).resolve(strict=True)
if not path.is_relative_to('/sys/devices') or not re.fullmatch(r'hwmon\d+', path.name):
    raise SystemExit('Not a sysfs hwmon directory')
valid_usb = False
for parent in path.parents:
    try:
        if ((parent / 'idVendor').read_text().strip() == '1e71' and
            (parent / 'idProduct').read_text().strip() in {'170e', '2007', '2014', '3008', '300e', '3012', '3014'}):
            valid_usb = True
            break
    except OSError:
        continue
if not valid_usb:
    raise SystemExit('Not an allowed Kraken USB device')
gid = grp.getgrnam('boreal').gr_gid
for item in path.iterdir():
    if re.fullmatch(r'pwm[12](_enable)?|temp[12]_auto_point([1-9]|[1-3][0-9]|40)_pwm', item.name):
        os.chown(item, 0, gid)
        os.chmod(item, 0o660)
